# English PP-OCRv6 is the default OCR engine.
OCR_ENGINE=ppocrv6
OCR_LANGUAGE=en
PADDLEOCR_DEVICE=cpu
# Optional DeepSeek-OCR settings (used only when OCR_ENGINE=deepseek).
MODEL_NAME=deepseek-ai/DeepSeek-OCR
OCR_DEVICE=cpu
OCR_LOAD_MODEL=true
MAX_UPLOAD_SIZE_MB=20
BASE_SIZE=1024
IMAGE_SIZE=640
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
